{
  "name": "kitchen_dashboard",
  "version": "1.0.0",
  "description": "Bull Board dashboard for Kitchen queue monitoring",
  "homepage": "https://github.com/Doma-Cooking/kitchen#readme",
  "bugs": {
    "url": "https://github.com/Doma-Cooking/kitchen/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Doma-Cooking/kitchen.git"
  },
  "license": "AGPL-3.0-only",
  "author": "jaewon@domacooking.com",
  "type": "module",
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "rm -rf dist",
    "start": "node dist/server.js",
    "dev": "tsx --watch src/server.ts",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.7",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0"
  },
  "dependencies": {
    "@bull-board/api": "^6.6.2",
    "@bull-board/express": "^6.6.2",
    "bullmq": "^5.66.5",
    "express": "^5.2.1",
    "express-basic-auth": "^1.2.1",
    "ioredis": "^5.6.1"
  }
}
