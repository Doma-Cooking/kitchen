{
  "mcpServers": {
    "slack": {
      "command": "npx",
      "args": ["tsx", "${CLAUDE_PLUGIN_ROOT}/tools/slack.ts"],
      "env": { "SLACK_BOT_TOKEN": "${SLACK_BOT_TOKEN}", "SLACK_USER_TOKEN": "${SLACK_USER_TOKEN}" }
    },
    "linear": {
      "command": "npx",
      "args": ["tsx", "${CLAUDE_PLUGIN_ROOT}/tools/linear.ts"],
      "env": {
        "LINEAR_CLIENT_ID": "${LINEAR_CLIENT_ID}",
        "LINEAR_CLIENT_SECRET": "${LINEAR_CLIENT_SECRET}"
      }
    },
    "notion": {
      "command": "npx",
      "args": ["tsx", "${CLAUDE_PLUGIN_ROOT}/tools/notion.ts"],
      "env": { "NOTION_TOKEN": "${NOTION_TOKEN}" }
    },
    "kitchen": {
      "command": "npx",
      "args": ["tsx", "${CLAUDE_PLUGIN_ROOT}/tools/kitchen.ts"],
      "env": { "REDIS_URL": "${REDIS_URL}" }
    }
  }
}
