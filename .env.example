
# ----- Required -----

# Anthropic API key (one of the two is required)
ANTHROPIC_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=

# ----- Optional -----

# Per-agent tokens
# Replace MY_AGENT with your agent's name in uppercase, matching the key in .kitchen.yaml
# Example: if your agent is named "aria" in .kitchen.yaml, use ARIA_SLACK_APP_TOKEN, etc.
MY_AGENT_SLACK_APP_TOKEN=xapp-...
MY_AGENT_SLACK_BOT_TOKEN=xoxb-...
MY_AGENT_SLACK_USER_TOKEN=xoxp-...
MY_AGENT_GITHUB_TOKEN=ghp_...
# Alternative: GitHub App auth (use instead of MY_AGENT_GITHUB_TOKEN)
# MY_AGENT_GITHUB_APP_ID=123456
# MY_AGENT_GITHUB_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...
# MY_AGENT_GITHUB_INSTALLATION_ID=12345678
MY_AGENT_LINEAR_CLIENT_ID=
MY_AGENT_LINEAR_CLIENT_SECRET=

# Claude Code session storage directory
CLAUDE_CONFIG_DIR=/data/claude

# Workspace directories
WORKSPACES_PATH=/data/workspaces
SNAPSHOTS_PATH=/data/snapshots
