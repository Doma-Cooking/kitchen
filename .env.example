
# ----- Required -----

# Anthropic API key (one of the two is required)
ANTHROPIC_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=

GITHUB_APP_ID=id...
GITHUB_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
GITHUB_INSTALLATION_ID=id...

# ----- Optional -----

# Claude Code session storage directory
CLAUDE_CONFIG_DIR=/data/claude

# Workspace directories
WORKSPACES_PATH=/data/workspaces
SNAPSHOTS_PATH=/data/snapshots

# Postgres credentials (override docker-compose defaults)
POSTGRES_DB=kitchen
POSTGRES_USER=kitchen
POSTGRES_PASSWORD=kitchen

# Per-agent tokens
# Replace AGENT with your agent's name in uppercase, matching the key in .kitchen.yaml
# Example: if your agent is named "aria" in .kitchen.yaml, use ARIA_SLACK_APP_TOKEN, etc.
AGENT_SLACK_APP_TOKEN=xapp-...
AGENT_SLACK_BOT_TOKEN=xoxb-...
AGENT_SLACK_USER_TOKEN=xoxp-...
AGENT_GITHUB_TOKEN=ghp_...
# Alternative: GitHub App auth (use instead of AGENT_GITHUB_TOKEN)
# AGENT_GITHUB_APP_ID=123456
# AGENT_GITHUB_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...
# AGENT_GITHUB_INSTALLATION_ID=12345678
AGENT_LINEAR_CLIENT_ID=
AGENT_LINEAR_CLIENT_SECRET=
