# --- Required ---

# GitHub App Configuration
GITHUB_APP_ID=your-app-id-here
GITHUB_APP_SLUG=your-app-slug-here
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nyour-key-here\n-----END RSA PRIVATE KEY-----"
GITHUB_INSTALLATION_ID=your-installation-id-here

# Claude Configuration
CLAUDE_CODE_OAUTH_TOKEN=your-claude-oauth-token-here

# Repository Configuration
REPO_URL=https://github.com/your-org/your-repo.git
CLONE_PATH=/tmp/repo
MAIN_BRANCH=main

# --- Optional ---

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=kitchen
DB_PASSWORD=kitchen
DB_NAME=kitchen

# Redis Configuration (for BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379

# BullMQ Configuration
KITCHEN_QUEUE_NAME=kitchenQueue

# GitHub Webhook Configuration
GITHUB_WEBHOOK_SECRET=your-webhook-secret-here

# Flutter Configuration
FLUTTER_CHANNEL=stable
FLUTTER_HOME=/opt/flutter

# Slack Notifications (Optional)
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_CHANNEL_ID=your-slack-channel-id