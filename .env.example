
# ----- Required -----

# Anthropic API key (one of the two is required)
ANTHROPIC_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=

# ----- Optional -----

# Per-agent tokens
TOPH_SLACK_APP_TOKEN=xapp-...
TOPH_SLACK_BOT_TOKEN=xoxb-...
TOPH_SLACK_USER_TOKEN=xoxp-...
TOPH_GITHUB_TOKEN=ghp_...
# Alternative: GitHub App auth (use instead of TOPH_GITHUB_TOKEN)
# TOPH_GITHUB_APP_ID=123456
# TOPH_GITHUB_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...
# TOPH_GITHUB_INSTALLATION_ID=12345678
TOPH_LINEAR_CLIENT_ID=
TOPH_LINEAR_CLIENT_SECRET=
TOPH_NOTION_TOKEN=ntn_...  # or secret_...

# Claude Code session storage directory
CLAUDE_CONFIG_DIR=/data/claude
