# Non-sensitive configuration for Kitchen server.
# Copy this file to .kitchen.yaml and adjust values.

port: 3000

redis:
  host: localhost
  port: 6379

db:
  host: localhost
  port: 5432
  user: kitchen
  name: kitchen

queue:
  name: kitchenQueue

github:
  appSlug: your-app-slug
  columns:
    planning: Planning
    implementing: In Progress
    ready: Ready
  label: "agent:enabled"

repos:
  - owner: your-org
    name: your-repo
    url: https://github.com/your-org/your-repo.git
    clonePath: /tmp/repos/your-repo
    mainBranch: main

slack:
  channelId: your-channel-id

models:
  resolve: claude-haiku-4-5-20251001
