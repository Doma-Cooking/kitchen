{
  "name": "kitchen",
  "version": "1.0.0",
  "description": "A host server for a set of AI agents that help build software.",
  "homepage": "https://github.com/Doma-Cooking/kitchen#readme",
  "bugs": {
    "url": "https://github.com/Doma-Cooking/kitchen/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Doma-Cooking/kitchen.git"
  },
  "license": "AGPL-3.0-only",
  "author": "jaewon@domacooking.com",
  "type": "module",
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsx scripts/generate-prompts.ts && tsc",
    "build:watch": "tsc --watch",
    "clean": "rm -rf dist",
    "start": "node dist/server.js",
    "dev": "tsx --watch src/server.ts",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "@types/ws": "^8.5.13",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.25",
    "@bull-board/api": "^6.6.2",
    "@bull-board/express": "^6.6.2",
    "@modelcontextprotocol/sdk": "^1.27.0",
    "@octokit/auth-app": "^7.2.2",
    "@octokit/graphql": "^8.2.2",
    "@octokit/webhooks": "^14.2.0",
    "@slack/bolt": "^4.6.0",
    "@slack/web-api": "^7.13.0",
    "bullmq": "^5.66.5",
    "express": "^5.2.1",
    "express-basic-auth": "^1.2.1",
    "ioredis": "^5.6.1",
    "postgres": "^3.4.8",
    "rxjs": "^7.8.1",
    "ws": "^8.18.0",
    "tsx": "^4.19.2",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  }
}
