{
  "name": "kitchen_server",
  "version": "1.0.0",
  "description": "A host server for a set of AI agents that help build software.",
  "homepage": "https://github.com/Doma-Cooking/kitchen#readme",
  "bugs": {
    "url": "https://github.com/Doma-Cooking/kitchen/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Doma-Cooking/kitchen.git"
  },
  "license": "AGPL-3.0-only",
  "author": "jaewon@domacooking.com",
  "type": "module",
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "rm -rf dist",
    "start": "node dist/server.js",
    "dev": "tsx --watch src/server.ts",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0"
  }
}
